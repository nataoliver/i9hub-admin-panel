# =============================================================================
# i9Hub Admin Panel v1.1.0 - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp .env.example .env
# =============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
APP_URL=https://seu-dominio.com

# --- Asaas (Pagamentos Recorrentes) ---
# Chave de acesso da API Asaas (obrigatório)
ASAAS_API_KEY=""
# Ambiente: "sandbox" ou "production"
ASAAS_ENV=sandbox
# Segredo do webhook para validação de assinaturas (opcional, mas recomendado)
ASAAS_WEBHOOK_SECRET=""

# --- Google Gemini AI ---
# Chave da API Gemini para funcionalidades de IA (classificação, scoring, etc.)
GEMINI_API_KEY=""

# --- SMTP (Envio de E-mails) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@seu-dominio.com"

# --- Segurança ---
# Chave secreta para assinatura de tokens JWT (gere com: openssl rand -hex 32)
JWT_SECRET=""
# Sal para hash de senhas
PASSWORD_SALT=""
